{
  "name": "@khulnasoft/style-guide",
  "version": "6.4.0",
  "description": "KhulnaSoft Engineering Style Guide (ESLint, Prettier, TypeScript base configs)",
  "keywords": [
    "eslint-config",
    "prettier-config",
    "typescript-config",
    "style-guide",
    "linting",
    "khulnasoft"
  ],
  "homepage": "https://github.com/khulnasoft/style-guide#readme",
  "bugs": {
    "url": "https://github.com/khulnasoft/style-guide/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khulnasoft/style-guide.git"
  },
  "license": "MPL-2.0",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./eslint": "./eslint/index.js",
    "./eslint/*": "./eslint/*.js",
    "./eslint/flat": "./eslint/flat.js",
    "./prettier": "./prettier/index.js",
    "./typescript": "./typescript/tsconfig.base.json",
    "./typescript/node16": "./typescript/tsconfig.node16.json",
    "./typescript/node18": "./typescript/tsconfig.node18.json",
    "./typescript/node20": "./typescript/tsconfig.node20.json",
    "./package.json": "./package.json"
  },
  "main": "index.js",
  "files": [
    "eslint",
    "prettier",
    "typescript",
    "index.js"
  ],
  "scripts": {
    "clean": "rm -rf node_modules .turbo .cache",
    "format": "prettier -w .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:strict": "eslint --max-warnings=0 .",
    "prepare": "husky install",
    "release": "semantic-release",
    "typecheck": "tsc -p typescript/tsconfig.base.json --noEmit"
  },
  "lint-staged": {
    "*": [
      "prettier -w --ignore-unknown"
    ]
  },
  "prettier": "./prettier",
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.23.10",
    "@rushstack/eslint-patch": "^1.7.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-playwright": "^1.5.2",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "eslint-plugin-vitest": "^0.3.22",
    "prettier-plugin-packagejson": "^2.4.12",
    "typescript-eslint": "^8.55.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-unicorn": "^51.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "semantic-release": "^24.2.9",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": ">=12.3.0 <15.0.0-0",
    "eslint": ">=8.48.0 <9",
    "prettier": ">=3.0.0 <4",
    "typescript": ">=4.8.0 <6"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "micromatch@<4.0.8": ">=4.0.8",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "@babel/helpers@<7.26.10": ">=7.26.10",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "lodash-es@>=4.0.0 <=4.17.22": ">=4.17.21",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.21",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.0",
      "minimatch@<10.2.1": ">=10.2.1",
      "ajv@<6.14.0": ">=6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0"
    }
  }
}
